# SkillBridge Backend Environment Variables
# Copy this to .env and fill in your values

# ── Google Gemini AI (Required for real AI features) ──────────────────────
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# ── Database (Optional — app uses in-memory fallback without these) ────────
# PostgreSQL direct connection
DATABASE_URL=postgresql://user:password@host:5432/skillbridge

# Supabase (alternative to direct PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhb...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhb...your_service_role_key

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=skillbridge-super-secret-jwt-key-change-in-production

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
